{
  "name": "auditworkbench-desktop",
  "version": "1.0.0",
  "description": "审计实务工坊 — AI多智能体审计分析平台 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable",
    "pack:win:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.auditworkbench.desktop",
    "productName": "审计实务工坊",
    "directories": { "output": "dist" },
    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
