# MinIO
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=audit-materials
MINIO_SECURE=false

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=auditkm_factory

# OCR (liteparse / mineru)
OCR_ENGINE=mineru
LITEPARSE_URL=http://127.0.0.1:5006

# LLM (OpenAI compatible)
LLM_API_BASE=http://127.0.0.1:8765/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=any
